From 7b692e2c7a233a13bb51d160718aafbcb5ea2f97 Mon Sep 17 00:00:00 2001
From: lvalen91 <lvalen91@users.noreply.github.com>
Date: Mon, 16 Nov 2026 16:25:24 -0900
Subject: [PATCH 101/104] ACPI: EC: use a 10 ms transaction timeout on the
 Apple Mac Pro 7,1

The Mac Pro 7,1 DSDT/ECDT declare a legacy EC that only macOS-path AML
uses. Every access times out and waits the default 500 ms, adding about
30 s to boot. Add a DMI quirk that lowers ec_delay to 10 ms unless it was
set on the command line (acpi.ec_delay).
---
 drivers/acpi/ec.c | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/drivers/acpi/ec.c b/drivers/acpi/ec.c
index a89f10256..db999448e 100644
--- a/drivers/acpi/ec.c
+++ b/drivers/acpi/ec.c
@@ -1953,6 +1953,21 @@ static int ec_honor_dsdt_gpe(const struct dmi_system_id *id)
 	return 0;
 }
 
+/*
+ * Apple Mac Pro 7,1 (T2): the DSDT/ECDT declare a legacy EC (PNP0C09, ports
+ * 0x62/0x66) that is only used by macOS-path AML, so every transaction on it
+ * times out and each one waits the full default ec_delay (500 ms), adding
+ * about 30 s to boot. Use a short timeout unless the user set one explicitly.
+ */
+static int ec_short_delay(const struct dmi_system_id *id)
+{
+	if (ec_delay == ACPI_EC_DELAY) {
+		pr_debug("Detected Mac Pro 7,1, using a 10 ms EC timeout.\n");
+		ec_delay = 10;
+	}
+	return 0;
+}
+
 static const struct dmi_system_id ec_dmi_table[] __initconst = {
 	{
 		/*
@@ -2017,6 +2032,14 @@ static const struct dmi_system_id ec_dmi_table[] __initconst = {
 			DMI_MATCH(DMI_SYS_VENDOR, "SAMSUNG ELECTRONICS CO., LTD."),
 		},
 	},
+	{
+		/* Apple Mac Pro 7,1: legacy EC unused, see ec_short_delay() */
+		.callback = ec_short_delay,
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "Apple Inc."),
+			DMI_MATCH(DMI_PRODUCT_NAME, "MacPro7,1"),
+		},
+	},
 	{}
 };
 
